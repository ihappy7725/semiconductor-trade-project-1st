# Copy to the project root .env only if it does not exist.
# Preserve existing settings; never commit API keys.
AXPORT_DATA_MODE=demo
EXCHANGERATE_API_KEY=
THENEWS_API_KEY=
CUSTOMS_API_KEY=
AXPORT_WEATHER_JSON=

# Chat is independent from widget demo/live mode.
# Set live and supply both values to enable the server-side OpenAI connection.
AXPORT_CHAT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=

# (junhee) 회원가입·로그인 (Supabase). 값은 .env 에만 적고 커밋하지 않는다. 설정 방법: junhee/docs/ACCOUNTS_SETUP.md
# 인증 메일 발송 계정(SMTP)은 Supabase 대시보드에서 설정하므로 여기에는 없다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 32자 이상 무작위 문자열. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
# 로컬(http://127.0.0.1)에서는 false, Render(https)에서는 비워 두면 true
SESSION_COOKIE_SECURE=false
# 선택: 인증 메일 링크의 기준 주소(예: https://axport.onrender.com). 비우면 접속한 주소를 쓴다
AXPORT_PUBLIC_URL=

# (junhee) 기업 파일 분석 엔진(sanghyeob) 외부 자료 API 키. 없으면 해당 지표만 '검색 불가'로 표시하고 분석은 계속한다.
UN_COMTRADE_API_KEY=
KCS_TRADE_API_KEY=
ECOS_API_KEY=
LAW_API_KEY=
# 선택: 한국수출입은행 환율(위젯 환율 예비 경로). 공공데이터포털 키는 KCS_TRADE_API_KEY 하나로 스크립트(DATA_GO_KR)·수출기상도(CUSTOMS_API_KEY)도 함께 쓴다
KOREAEXIM_API_KEY=
# 위젯 공식 자료(환율·뉴스·수출기상도) 자동 갱신: Render 에서는 기본 켜짐, 로컬은 1 로 켠다(0 은 끔)
AXPORT_WIDGET_REFRESH=
